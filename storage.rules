rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function memberPath(schoolId) {
      return /databases/(default)/documents/schools/$(schoolId)/members/$(request.auth.uid);
    }

    function schoolPath(schoolId) {
      return /databases/(default)/documents/schools/$(schoolId);
    }

    function member(schoolId) {
      return firestore.get(memberPath(schoolId)).data;
    }

    function isMember(schoolId) {
      return signedIn()
        && firestore.exists(schoolPath(schoolId))
        && firestore.get(schoolPath(schoolId)).data.status == 'active'
        && firestore.exists(memberPath(schoolId))
        && member(schoolId).status == 'active';
    }

    function isSchoolAdmin(schoolId) {
      return isMember(schoolId)
        && member(schoolId).role in ['schoolAdmin', 'superAdmin', 'director', 'headTeacher'];
    }

    function isLinkedStudent(schoolId, studentId) {
      return isMember(schoolId)
        && member(schoolId).role == 'student'
        && member(schoolId).get('linkedRecordType', '') == 'student'
        && member(schoolId).get('linkedRecordId', '') == studentId;
    }

    function isLinkedParent(schoolId, studentId) {
      return isMember(schoolId)
        && member(schoolId).role == 'parent'
        && firestore.exists(/databases/(default)/documents/schools/$(schoolId)/members/$(request.auth.uid)/linkedStudents/$(studentId));
    }

    function validImage(maxBytes) {
      return request.resource.size <= maxBytes
        && request.resource.contentType.matches('image/.*');
    }

    match /schools/{schoolId}/members/{uid}/profile/{fileName} {
      allow read: if isMember(schoolId) && (request.auth.uid == uid || isSchoolAdmin(schoolId));
      allow create, update: if isMember(schoolId)
        && (request.auth.uid == uid || isSchoolAdmin(schoolId))
        && validImage(5 * 1024 * 1024);
      allow delete: if isMember(schoolId) && (request.auth.uid == uid || isSchoolAdmin(schoolId));
    }

    match /schools/{schoolId}/students/{studentId}/{fileName=**} {
      allow read: if isSchoolAdmin(schoolId)
        || isLinkedStudent(schoolId, studentId)
        || isLinkedParent(schoolId, studentId);
      allow create, update: if isSchoolAdmin(schoolId)
        && validImage(20 * 1024 * 1024);
      allow delete: if isSchoolAdmin(schoolId);
    }

    match /schools/{schoolId}/schoolAssets/{fileName=**} {
      allow read: if isMember(schoolId);
      allow create, update: if isSchoolAdmin(schoolId)
        && request.resource.size <= 20 * 1024 * 1024
        && request.resource.contentType != null;
      allow delete: if isSchoolAdmin(schoolId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
